# Uso local somente (NUNCA commitar credenciais reais)
DB_NAME=traceguard
DB_URL=jdbc:postgresql://localhost:5432/traceguard
DB_USERNAME=traceguard
DB_PASSWORD=change_me_local_only

REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_ENABLED=true

# Minimo 32 caracteres em qualquer ambiente
JWT_SECRET=change_me_with_at_least_32_characters
JWT_ISSUER=traceguard-api
JWT_AUDIENCE=traceguard-admin-api

SPRING_PROFILES_ACTIVE=dev

# Seed data (dev apenas — primeiro admin ao iniciar)
SEED_ADMIN_EMAIL=admin@traceguard.local
SEED_ADMIN_PASSWORD=admin123
