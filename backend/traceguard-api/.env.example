# Aplicacao TraceGuard API - exemplo local
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/traceguard
DB_USERNAME=traceguard
DB_PASSWORD=change_me_local_only

REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_ENABLED=false

JWT_SECRET=change_me_with_at_least_32_characters
JWT_ISSUER=traceguard-api
JWT_AUDIENCE=traceguard-admin-api
